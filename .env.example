# ---------- 9KGwash 环境变量 ----------
# WebUI 端口
WEB_PORT=5000
# 时区（日志时间）
TZ=Asia/Shanghai

# 网盘挂载的宿主机绝对路径（建议 CIFS/NFS/local 均可）
CLOUD_MOUNT=/mnt/clouddrive/CloudDrive
# 本地元数据目录的宿主机绝对路径（.strm/.nfo 所在）
METADATA_HOST_DIR=/mnt/user/appdata/9kgwash/metadata
# 115 离线下载「重命名文件夹」的宿主机路径（文件投递功能用，可选）
DELIVER_INBOX=/mnt/user/CloudDrive/重命名

# —— 可选：结构路径覆盖（留空则完全读取 /config/config.json）——
# MOUNT_BASE_PATH=/media/CloudDrive
# METADATA_BASE_PATH=/metadata
# WATCHED_DIRS=/115open/9KG/STRM
